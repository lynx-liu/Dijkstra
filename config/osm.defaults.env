# OpenStreetMap / graph build defaults (source with: source config/osm.defaults.env)

GEOFABRIK_URL=https://download.geofabrik.de/asia/china-latest.osm.pbf
DATA_DIR=data
OSM_DIR=${DATA_DIR}/osm
GRAPH_DIR=${DATA_DIR}/graph

PBF_PATH=${OSM_DIR}/china-latest.osm.pbf
GRAPH_PATH=${GRAPH_DIR}/china.mmlp.bin

# Include Central Asia five countries in the same routing graph as China.
# 1 = download + merge into graph (default). 0 = China-only.
INCLUDE_CENTRAL_ASIA="${INCLUDE_CENTRAL_ASIA:-1}"

# Geofabrik Asia extracts (中亚五国)
CA_KZ_URL=https://download.geofabrik.de/asia/kazakhstan-latest.osm.pbf
CA_KG_URL=https://download.geofabrik.de/asia/kyrgyzstan-latest.osm.pbf
CA_TJ_URL=https://download.geofabrik.de/asia/tajikistan-latest.osm.pbf
CA_TM_URL=https://download.geofabrik.de/asia/turkmenistan-latest.osm.pbf
CA_UZ_URL=https://download.geofabrik.de/asia/uzbekistan-latest.osm.pbf

CA_KZ_PBF=${OSM_DIR}/kazakhstan-latest.osm.pbf
CA_KG_PBF=${OSM_DIR}/kyrgyzstan-latest.osm.pbf
CA_TJ_PBF=${OSM_DIR}/tajikistan-latest.osm.pbf
CA_TM_PBF=${OSM_DIR}/turkmenistan-latest.osm.pbf
CA_UZ_PBF=${OSM_DIR}/uzbekistan-latest.osm.pbf

# Merged PBF used when osmium is available (optional).
MERGED_PBF_PATH=${OSM_DIR}/china_central_asia-latest.osm.pbf

# Coverage stamp written next to the graph (space-separated region codes).
# china = Geofabrik China; kz/kg/tj/tm/uz = Central Asia five.
GRAPH_COVERAGE_REQUIRED_CHINA="china"
GRAPH_COVERAGE_REQUIRED_CA="china kz kg tj tm uz"

# Empty = build from full PBF. Example Xinjiang focus: 73.5,34.3,96.4,49.2
# BBOX=

# Set to 1 to run osmium bbox extract before import (requires osmium-tool)
USE_OSMIUM_EXTRACT=0

# Offline map tiles — ensured by bootstrap_service.sh and start_http_server.sh
# (download_mbtiles.sh is an internal helper; operators need not call it).
# Air-gapped: SKIP_MBTILES=1

MAP_DIR=data/map
# Final mbtiles path used by HTTP service (override with MMLP_MBTILES)
MBTILES_PATH=${MAP_DIR}/china.mbtiles
# Preferred combined / multi-file coverage stamp (China + Central Asia + Russia).
MBTILES_CA_DIR=${MAP_DIR}/central_asia
MBTILES_RU_DIR=${MAP_DIR}/russia
MBTILES_MERGED_PATH=${MAP_DIR}/china_central_asia.mbtiles

# Include Central Asia five-country Shortbread overlays (default on).
INCLUDE_CENTRAL_ASIA_MAP="${INCLUDE_CENTRAL_ASIA_MAP:-${INCLUDE_CENTRAL_ASIA:-1}}"

# Include Russia federal-district Shortbread overlays from Geofabrik (default on).
INCLUDE_RUSSIA_MAP="${INCLUDE_RUSSIA_MAP:-${INCLUDE_RUSSIA:-1}}"

# Skip any Russia district package larger than this (bytes). Far East listing is ~53GB.
MAX_RU_MBTILES_BYTES="${MAX_RU_MBTILES_BYTES:-8589934592}"

# BBBike China Shortbread vector tiles (~2.1 GB zip → ~2 GB mbtiles). Updated weekly.
MBTILES_DOWNLOAD_URL=https://download3.bbbike.org/osm/mbtiles/region/asia/china/china.osm.mbtiles-shortbread.zip
MBTILES_ZIP_NAME=china.mbtiles-shortbread.zip
# Path inside the zip archive (BBBike: china-mbtiles-shortbread/china.mbtiles)
MBTILES_ZIP_MEMBER=china-mbtiles-shortbread/china.mbtiles

# BBBike Shortbread overlays for 中亚五国 (served alongside china.mbtiles).
CA_KZ_MBTILES_URL=https://download3.bbbike.org/osm/mbtiles/region/asia/kazakhstan/kazakhstan.osm.mbtiles-shortbread.zip
CA_KG_MBTILES_URL=https://download3.bbbike.org/osm/mbtiles/region/asia/kyrgyzstan/kyrgyzstan.osm.mbtiles-shortbread.zip
CA_TJ_MBTILES_URL=https://download3.bbbike.org/osm/mbtiles/region/asia/tajikistan/tajikistan.osm.mbtiles-shortbread.zip
CA_TM_MBTILES_URL=https://download3.bbbike.org/osm/mbtiles/region/asia/turkmenistan/turkmenistan.osm.mbtiles-shortbread.zip
CA_UZ_MBTILES_URL=https://download3.bbbike.org/osm/mbtiles/region/asia/uzbekistan/uzbekistan.osm.mbtiles-shortbread.zip

CA_KZ_MBTILES=${MBTILES_CA_DIR}/kazakhstan.mbtiles
CA_KG_MBTILES=${MBTILES_CA_DIR}/kyrgyzstan.mbtiles
CA_TJ_MBTILES=${MBTILES_CA_DIR}/tajikistan.mbtiles
CA_TM_MBTILES=${MBTILES_CA_DIR}/turkmenistan.mbtiles
CA_UZ_MBTILES=${MBTILES_CA_DIR}/uzbekistan.mbtiles

# Geofabrik experimental Shortbread mbtiles per Russian federal district
# (https://download.geofabrik.de/russia/<district>-shortbread-1.0.mbtiles).
RU_FED_DISTRICTS="central-fed-district crimean-fed-district far-eastern-fed-district north-caucasus-fed-district northwestern-fed-district siberian-fed-district south-fed-district ural-fed-district volga-fed-district"

# Smaller regional packages can be placed manually at data/map/region.mbtiles

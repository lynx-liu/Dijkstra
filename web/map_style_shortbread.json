{
  "version": 8,
  "name": "Shortbread offline",
  "glyphs": "/web/vendor/map/glyphs/{fontstack}/{range}.pbf",
  "sources": {
    "shortbread": {
      "type": "vector",
      "tiles": ["/api/map/tiles/{z}/{x}/{y}.pbf"],
      "minzoom": 0,
      "maxzoom": 14
    }
  },
  "layers": [
    {
      "id": "bg",
      "type": "background",
      "paint": { "background-color": "#f2efe9" }
    },
    {
      "id": "ocean",
      "type": "fill",
      "source": "shortbread",
      "source-layer": "ocean",
      "minzoom": 8,
      "paint": { "fill-color": "#aad3df" }
    },
    {
      "id": "water_polygons",
      "type": "fill",
      "source": "shortbread",
      "source-layer": "water_polygons",
      "minzoom": 4,
      "paint": { "fill-color": "#aad3df" }
    },
    {
      "id": "water_lines",
      "type": "line",
      "source": "shortbread",
      "source-layer": "water_lines",
      "minzoom": 4,
      "paint": { "line-color": "#99c8db", "line-width": 1 }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "shortbread",
      "source-layer": "land",
      "minzoom": 7,
      "paint": { "fill-color": "#f2efe9" }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "shortbread",
      "source-layer": "boundaries",
      "paint": { "line-color": "#9e8cab", "line-width": 1, "line-opacity": 0.5 }
    },
    {
      "id": "street_polygons",
      "type": "fill",
      "source": "shortbread",
      "source-layer": "street_polygons",
      "minzoom": 10,
      "paint": {
        "fill-color": [
          "match",
          ["get", "kind"],
          "motorway", "#e35d7a",
          "trunk", "#ef8e63",
          "primary", "#f7ba56",
          "secondary", "#f3db76",
          "#f3efe5"
        ],
        "fill-opacity": 0.95
      }
    },
    {
      "id": "streets",
      "type": "line",
      "source": "shortbread",
      "source-layer": "streets",
      "minzoom": 11,
      "paint": {
        "line-color": [
          "match",
          ["get", "kind"],
          "motorway", "#bf2f4d",
          "trunk", "#cc5f2d",
          "primary", "#c68512",
          "secondary", "#a08a2e",
          "#a59a86"
        ],
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          11, 0.6,
          13, 1.2,
          14, 1.8,
          16, 3
        ],
        "line-opacity": 0.95
      }
    },
    {
      "id": "place_labels",
      "type": "symbol",
      "source": "shortbread",
      "source-layer": "place_labels",
      "minzoom": 6,
      "layout": {
        "text-field": ["coalesce", ["get", "name"], ["get", "name_en"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          6, 10,
          10, 12,
          14, 14
        ]
      },
      "paint": {
        "text-color": "#3a3a3a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.1
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "shortbread",
      "source-layer": "buildings",
      "minzoom": 14,
      "paint": { "fill-color": "#d9d0c9", "fill-opacity": 0.75 }
    }
  ]
}
